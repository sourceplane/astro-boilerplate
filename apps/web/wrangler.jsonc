// What the adapter builds from: the Worker's name, its compatibility and its
// bindings (`astro dev` reads them too). It has no `main` — the adapter
// supplies its own server entrypoint. What deploys is wrangler.deploy.jsonc;
// keep the two in step (src/test/deploy-config.test.ts holds them to it).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-boilerplate-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
